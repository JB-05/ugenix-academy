# Site URL (used for canonical, Open Graph, sitemap; no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudinary Configuration
# Get these values from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sheets Configuration (Using Google Apps Script)
# 1. Open your Google Sheet
# 2. Go to Extensions > Apps Script
# 3. Paste the script code (see GOOGLE_APPS_SCRIPT.md)
# 4. Set a secret token in the script (replace YOUR_SECRET_TOKEN_HERE)
# 5. Click Deploy > New deployment
# 6. Select type: Web app
# 7. Set Execute as: Me, Who has access: Anyone
# 8. Click Deploy and copy the Web App URL
# 9. Paste the URL and secret token below
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SCRIPT_SECRET_TOKEN=your_secret_token_here

# V.I.S.T.A. Idea Pitching Competition (Google Apps Script)
# Configure a separate Apps Script (or separate sheet/tab) for V.I.S.T.A. submissions
GOOGLE_VISTA_SCRIPT_URL=https://script.google.com/macros/s/YOUR_VISTA_SCRIPT_ID/exec
GOOGLE_VISTA_SCRIPT_SECRET_TOKEN=UGENIX_ACADEMY_VISTA_2026

# Razorpay (WorkSim registration)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Amount in paise (50000 = ₹500). Must match WORKSIM_REGISTRATION_FEE_INR in lib/constants.ts
WORKSIM_REGISTRATION_AMOUNT_PAISE=50000

# WorkSim registrations (Google Apps Script — optional separate sheet/script)
GOOGLE_WORKSIM_SCRIPT_URL=https://script.google.com/macros/s/YOUR_WORKSIM_SCRIPT_ID/exec
GOOGLE_WORKSIM_SCRIPT_SECRET_TOKEN=your_worksim_secret_token
